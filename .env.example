# Copy this file to .env and fill in the blanks. NEVER commit the real .env.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://rag:change-me@db:5432/rag_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# From https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults are in backend/app/core/config.py)
# LLM_MODEL=openai/gpt-4o-mini
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# COOKIE_SECURE=false
# Never change the embedding model after documents exist: vectors would stop matching.
# EMBEDDING_MODEL=openai/text-embedding-3-small